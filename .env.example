# CORRECTIF du modèle : la ligne d'origine était `DATABASE_URL://risk:risk@localhost:5432/risks`
#   - `=` manquant après DATABASE_URL (syntaxe dotenv invalide => variable jamais définie)
#   - scheme `postgresql://` absent
#   - mauvais port : docker-compose publie 5435, pas 5432
DATABASE_URL=postgresql://risk:risk@localhost:5435/risks
SEC_USER_AGENT=Prénom Nom ton.email@example.com
CACHE_DIR=data/cache
NEXT_PUBLIC_API_URL=http://localhost:8011
# URL publique du site (SEO : canonical + sitemap) — mise à jour en production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origines navigateur autorisées à appeler l'API (séparées par des virgules)
FRONTEND_ORIGINS=http://localhost:3000
# Secret partagé avec le BFF Next.js ; générer une valeur aléatoire avant activation
WATCHLIST_API_SECRET=
# Alertes e-mail du nightly (changement de palier sur une entreprise suivie).
# Vide = envoi désactivé : le nightly journalise les changements sans envoyer.
# Port 465 = TLS implicite, sinon STARTTLS (587 chez la plupart des relais).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Expéditeur sur un domaine vérifié chez le fournisseur (SPF/DKIM)
ALERT_FROM_EMAIL=
# URL publique du site pour les liens des e-mails (= NEXT_PUBLIC_SITE_URL)
SITE_URL=http://localhost:3000
