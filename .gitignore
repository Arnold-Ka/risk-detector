# Secrets / local config — must stay out of git
.env

# Frontend (created in a later step)
node_modules/
frontend/.next/

# EDGAR raw responses cache (created by app/edgar/client.py)
data/cache/

# CSV d'ingestion du backtest (rejouables depuis le cache EDGAR :
# data/backtest/companies.json reste versionné, les exports ne le sont pas)
data/backtest/*_facts.csv
data/backtest/*_ratios.csv
# Jeu de données DL (régénérable via scripts/export_dataset.py)
data/backtest/dl_dataset.csv
# Artefact du modèle séquentiel : VERSIONNÉ (111 Ko) pour que le nightly
# hébergé (GitHub Actions) publie aussi les signaux lstm — voir docs/DEPLOY.md.
# Se régénère par scripts/train_lstm.py.
# (dump de migration PostgreSQL, cf. docs/DEPLOY.md — données sensibles)
*.dump
